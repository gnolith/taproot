{
  "name": "@gnolith/taproot",
  "version": "0.5.0",
  "description": "Portable canonical knowledge, content, authorization, and hybrid search layer for Gnolith.",
  "author": "Gnolith contributors",
  "keywords": [
    "cloudflare-d1",
    "sqlite",
    "knowledge-graph",
    "rdf",
    "sparql",
    "wikibase"
  ],
  "type": "module",
  "private": false,
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/gnolith/taproot.git"
  },
  "homepage": "https://github.com/gnolith/taproot#readme",
  "bugs": {
    "url": "https://github.com/gnolith/taproot/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    },
    "./adapters/openai-compatible": {
      "types": "./dist/adapters-openai-compatible.d.ts",
      "import": "./dist/adapters-openai-compatible.js"
    },
    "./adapters/ollama-compatible": {
      "types": "./dist/adapters-ollama-compatible.d.ts",
      "import": "./dist/adapters-ollama-compatible.js"
    },
    "./adapters/sqlite-vector": {
      "types": "./dist/adapters-sqlite-vector.d.ts",
      "import": "./dist/adapters-sqlite-vector.js"
    },
    "./adapters/qdrant": {
      "types": "./dist/adapters-qdrant.d.ts",
      "import": "./dist/adapters-qdrant.js"
    },
    "./sparql-policy": {
      "types": "./dist/sparql-policy.d.ts",
      "import": "./dist/sparql-policy.js"
    },
    "./backup": {
      "types": "./dist/backup.d.ts",
      "import": "./dist/backup.js"
    },
    "./migrations/*": "./migrations/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "migrations",
    "examples",
    "COMPATIBILITY.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "baseline:hybrid-search": "npm run build && node scripts/hybrid-search-baseline.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run interop:check && npm run pack:check && npm run consumer:check && npm run licenses:check && npm run repository:check",
    "consumer:check": "node scripts/consumer-smoke.mjs && node scripts/typescript-consumer.mjs",
    "interop:check": "vitest run test/interop.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses:check": "node scripts/license-check.mjs",
    "lint": "eslint .",
    "materialize:diamond": "node scripts/materialize-diamond.mjs",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "repository:check": "node scripts/repository-check.mjs",
    "baseline:search-source-events": "npm run build && node scripts/search-source-event-baseline.mjs",
    "baseline:search-materialization": "npm run build && node scripts/search-materialization-baseline.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:candidate": "node scripts/release-candidate.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run test/repository.test.ts test/interop.test.ts",
    "test:persistence": "vitest run test/persistence.test.ts test/migration-recovery.test.ts",
    "test:qdrant": "npm run build && node scripts/qdrant-conformance.mjs",
    "test:unit": "vitest run test/rdf.test.ts test/scaffold.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gnolith/diamond": "0.5.0",
    "@rdfjs/types": "^2.0.1",
    "rdf-data-factory": "^2.0.2"
  },
  "packageManager": "npm@11.9.0",
  "overrides": {
    "@vitest/coverage-v8": {
      "test-exclude": "8.0.0"
    },
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.7.0",
    "miniflare": "^4.20260714.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
